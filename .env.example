BOT_TOKEN=replace_with_token_from_botfather
# Optional: full path to yt-dlp.exe on Windows
# YTDLP_PATH=C:\\tools\\yt-dlp.exe
# Optional: full path to gallery-dl.exe for Instagram pictures/carousels
# GALLERY_DL_PATH=C:\\tools\\gallery-dl.exe
MAX_FILE_SIZE_MB=49
# If Instagram blocks anonymous public requests, use a browser where Instagram is open:
# Local only: reuse cookies from a browser installed on this machine.
# YTDLP_BROWSER=chrome
# Railway: base64-encoded Netscape cookies exported from a logged-in browser.
# YTDLP_COOKIES_BASE64=